# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DATABASE=nexoclima_raw

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/nexoclima

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com
RECIFE_LATITUDE=-8.05
RECIFE_LONGITUDE=-34.9

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Future AI integration
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Scheduler
COLLECTION_INTERVAL_MINUTES=60
